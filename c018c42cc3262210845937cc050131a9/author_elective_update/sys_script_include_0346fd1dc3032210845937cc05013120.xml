        <script><![CDATA[var Test = Class.create();
Test.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {

   getPatientDetails: function() {
      var patientId = this.getParameter('sysparm_patient_id');

      var gr = new GlideRecord('u_patient');
      if (gr.get(patientId)) {
         var result = {
            name: gr.getValue('u_first_name') + ' ' + gr.getValue('u_last_name'),
            age: gr.getValue('u_age'),
            gender: gr.getDisplayValue('u_gender'),
			vip: gr.getValue('u_vip')
         };
         return new global.JSON().encode(result); // ✅ Fixed here
      }
	  
   },

   type: 'Test'

});]]></script>
