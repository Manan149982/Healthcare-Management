        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var PatientUtils1 = Class.create();
PatientUtils1.prototype = {
  initialize :function(){},
 
 
  fetchDetails: function(patientid) {
    var gr = new GlideRecord('u_patient');
    if (!gr.get(patientid)) {
      throw 'Patient record not found for sys_id: ' + patientid;
    }
    // build the result
    return {
      name:   gr.getValue('u_first_name') + ' ' + gr.getValue('u_last_name'),
      age:    parseInt(gr.getValue('u_age'), 10),
      gender: gr.getDisplayValue('u_gender'),
      vip:    gr.getValue('u_vip') === 'true'
    };
  },
 
  type: 'PatientUtils1'
};
 ]]></script>
