        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue == '') {
        return;
    }

    var ga = new GlideAjax('DoctorUtils1');
    ga.addParam('sysparm_name', 'getDoctorsByDepartment');
    ga.addParam('sysparm_department_id', newValue);
    ga.getXMLAnswer(function(response) {
        var doctorOptions = response.split(',');
        g_form.clearOptions('doctor');
        g_form.addOption('doctor', '', '-- Select Doctor --');

        for (var i = 0; i < doctorOptions.length; i++) {
            var parts = doctorOptions[i].split(':');
            g_form.addOption('doctor', parts[1], parts[0]);
        }
    });
}
]]></script>
