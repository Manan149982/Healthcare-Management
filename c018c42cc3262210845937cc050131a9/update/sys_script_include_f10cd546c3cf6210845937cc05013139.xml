        <script><![CDATA[var DoctorUtils1 = Class.create();
DoctorUtils1.prototype = Object.extendsObject(AbstractAjaxProcessor, {
    getDoctorsByDepartment: function() {
        var deptId = this.getParameter("sysparm_department_id");
        var doctors = [];
        var gr = new GlideRecord("u_doctor");
        gr.addQuery("u_department", deptId);
        gr.query();
        while (gr.next()) {
            doctors.push(gr.getDisplayValue("u_first_name") + ':' + gr.getUniqueValue());
        }
        return doctors.join(',');
    }
});
]]></script>
